<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>
<BorderPane fx:id="dataPane" styleClass="root-pane" stylesheets="@../../assist/css/interface/layout/data.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mj.pc.square.io.separator.java.controller.layout.DataLayoutController">
    <top>
        <VBox minHeight="26.0" BorderPane.alignment="CENTER">
            <Label fx:id="title" styleClass="title" text="%control.label.title"/>
            <Separator/>
        </VBox>
    </top>
    <center>
        <TextFlow BorderPane.alignment="CENTER">
            <Label fx:id="body" text="%control.label.body"/>
        </TextFlow>
    </center>
</BorderPane>
